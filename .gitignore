# ═══════════════════════════════════════════════════════════════
# AIAC 产品研判系统 · 仓库忽略规则（2026-09-17 git init 时创建）
# 原则：只跟踪源码与文档；依赖、构建产物、运行数据、密钥、日志一律忽略
# ═══════════════════════════════════════════════════════════════

# ———— 依赖与构建产物 ————
node_modules/
dist/
__pycache__/
*.pyc

# ———— 环境与密钥（绝不入库）————
# backend/.env 含百炼/DeepSeek API key；frontend/.env.local 是本机联调开关
.env
.env.local

# ———— 运行数据（冒烟/演示会持续改写）————
backend/data/
*.db
*.db-shm
*.db-wal

# ———— 日志与临时文件 ————
*.log
backend/.pid
*.tmp

# ———— IDE / 工具 ————
.codebuddy/
.vscode/
.idea/

# ———— 系统 ————
Thumbs.db
.DS_Store
